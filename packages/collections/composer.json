{
    "name": "tilttek/collections",
    "description": "Collectible items for gamification: items with a rarity, sets worth a reward once complete, copies and doubles per member, the item of the day on a computed calendar, packs drawn by rarity with published odds and verifiable seeds, moves between members for trades, and the export and erasure of a member",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "collections",
        "collectibles",
        "rarity",
        "gamification"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "ext-sodium": "*",
        "phil/resource": "^0.1@dev",
        "psr/clock": "^1.0",
        "tilttek/activity": "^0.1@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\Collections\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\Collections\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
