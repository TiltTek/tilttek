{#
 # A participant's lines and veils and consent checklist, each changed at any moment.
 #}
{% extends layout %}
{%- set domain = 'tilttek_table_safety' -%}
{% block body %}
<main class="tilttek-table-safety">
    <h1>{{ 'answers.title'|trans({}, domain) }}</h1>
    {{ include('@TilttekTableSafety/_nav.html.twig', {game_master: false}) }}
    {%- if saved %}{{ include('@TilttekTableSafety/_saved.html.twig') }}{% endif %}
    <p>{{ 'answers.private'|trans({}, domain) }}</p>
    {%- for name, form in forms %}
    <section aria-labelledby="tilttek-table-safety-{{ name }}">
        <h2 id="tilttek-table-safety-{{ name }}">{{ ('answers.' ~ name)|trans({}, domain) }}</h2>
        <p>{{ ('answers.' ~ name ~ '_help')|trans({}, domain) }}</p>
        {{ form_start(form) }}
            {{ form_widget(form) }}
            {% component (table_safety_kit('Button')) with {type: 'submit'} %}{% block content %}{{ 'answers.save'|trans({}, domain) }}{% endblock %}{% endcomponent %}
        {{ form_end(form) }}
    </section>
    {%- endfor %}
</main>
{% endblock %}
