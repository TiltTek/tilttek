{
    "name": "tilttek/reference-tables",
    "description": "Look up a game system's reference tables during play, by key or by range, or roll them with their die; each table keeps its source, licence and page.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "role-playing-games",
        "reference-tables",
        "game-master",
        "random-tables",
        "dice"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "symfony/yaml": "^8.2",
        "tilttek/dice": "^0.3@dev",
        "tilttek/rpg-systems": "^0.1@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\ReferenceTables\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\ReferenceTables\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
