{
    "name": "tilttek/accessible-dice",
    "description": "Dice anyone can roll in a Symfony site: large targets, faces spoken and described, and results announced to screen readers, with reduced motion respected.",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "dice",
        "accessibility",
        "a11y",
        "screen-reader",
        "rpg",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-filter": "*",
        "ext-sodium": "*",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/translation-contracts": "^3.8",
        "tilttek/dice": "^0.3@dev",
        "tilttek/dice-bundle": "^0.2@dev"
    },
    "require-dev": {
        "php-webdriver/webdriver": "^1.16",
        "phpunit/phpunit": "^13.4",
        "symfony/event-dispatcher": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/panther": "^2.4",
        "symfony/stimulus-bundle": "^3.8",
        "symfony/translation": "^8.2",
        "symfony/twig-bridge": "^8.2",
        "symfony/twig-bundle": "^8.2",
        "symfony/yaml": "^8.2",
        "twig/twig": "^3.31"
    },
    "suggest": {
        "symfony/stimulus-bundle": "For the controller that shows the expression and announces the results",
        "symfony/translation": "To translate the words of the form and the announcements, and the labels of the faces",
        "symfony/twig-bundle": "For accessible_dice() and the form"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\AccessibleDice\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\AccessibleDice\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
