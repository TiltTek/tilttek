{
    "name": "tilttek/dice-skins",
    "description": "A member's dice appearance — skins, colours, materials and owned dice — applied to the roller, its numbers kept readable.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "phil/resource": "^0.1@dev",
        "tilttek/collections": "^0.1@dev || ^0.2@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "symfony/clock": "^8.2",
        "tilttek/dice-bundle": "^0.2@dev"
    },
    "conflict": {
        "tilttek/dice-bundle": "<0.2"
    },
    "suggest": {
        "tilttek/dice-bundle": "To dress the dice of its roller with the appearance of a member's dice, through DiceBundle\\DiceSkinsAppearance (0.2.0-alpha or later)"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\DiceSkins\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\DiceSkins\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
