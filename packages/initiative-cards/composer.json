{
    "name": "tilttek/initiative-cards",
    "description": "Turn order dealt from a card deck each round: hidden combatants, defeated ones faded and skipped, players ending their own turns and naming who goes next.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "role-playing-games",
        "initiative",
        "combat",
        "cards",
        "turn-order"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "tilttek/card-deck": "^0.1@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\InitiativeCards\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\InitiativeCards\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
