{#
 # What anyone may see of a member's badges — their title, their showcase, the badges they show:
 #
 #     {{ include('@TilttekBadges/showcase.html.twig', {showcase: tilttek_badges_showcase('member:44')}) }}
 #
 # The names and descriptions are translated in the domain of the configuration (`badges` by default). An image is
 # decorative beside the name, and has an empty alternative text.
 #}
{% set domain = tilttek_badges_domain() %}
<section class="tilttek-badges" aria-label="{{ label|default('Badges') }}">
    {% if showcase.title %}
        <p class="tilttek-badges__title">{{ showcase.title.name|trans({}, domain) }}</p>
    {% endif %}
    {% for group in [{name: 'featured', badges: showcase.featured}, {name: 'shown', badges: showcase.shown}] %}
        {% if group.badges is not empty %}
            <ul class="tilttek-badges__{{ group.name }}">
                {% for badge in group.badges %}
                    <li class="tilttek-badges__badge" data-badge="{{ badge.code }}">
                        {% if badge.image %}<img src="{{ badge.image }}" alt="" width="48" height="48">{% endif %}
                        <span class="tilttek-badges__name">{{ badge.name|trans({}, domain) }}</span>
                        {% if badge.description %}<span class="tilttek-badges__description">{{ badge.description|trans({}, domain) }}</span>{% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    {% endfor %}
</section>
