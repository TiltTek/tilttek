{
    "name": "tilttek/conditions",
    "description": "Track conditions on characters during play: how long they last in rounds or time, how they stack and decay, and what they change on the sheet.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "role-playing-games",
        "conditions",
        "status-effects",
        "combat-tracker",
        "modifiers"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "symfony/clock": "^8.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\Conditions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\Conditions\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
