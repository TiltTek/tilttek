{
    "name": "tilttek/turn-clock",
    "description": "A turn timer for the table: per-player budgets, Fischer or Bronstein increments, delays, days per move, pauses, vacations and overtime.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "board-games",
        "role-playing-games",
        "game-clock",
        "turn-timer",
        "time-control"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "symfony/clock": "^8.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\TurnClock\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\TurnClock\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
