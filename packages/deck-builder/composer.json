{
    "name": "tilttek/deck-builder",
    "description": "Build card decks that follow a format's rules: sizes, copies, bans and taboo lists checked with readable errors, versions compared, owned cards respected.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\DeckBuilder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\DeckBuilder\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
