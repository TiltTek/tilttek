{
    "name": "tilttek/celebrations",
    "description": "Celebrate each reward a member earns exactly once: an inbox that gathers achievements from any package, groups them and honours reduced motion.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "gamification",
        "rewards",
        "achievements",
        "inbox",
        "celebration",
        "reduced-motion"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "phil/resource": "^0.1@dev",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "symfony/clock": "^8.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\Celebrations\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\Celebrations\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
