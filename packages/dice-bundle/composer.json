{
    "name": "tilttek/dice-bundle",
    "description": "Dice for Symfony on tilttek/dice: limits, custom dice and notations from the configuration, a journal of replayable rolls in Doctrine, by member and by table, announced by an event, macros of a site, a table and a member, verifiable rolls, a form field and its constraint, Twig filters and functions, an accessible detail of a roll, and an extension point that dresses a member's dice, with an ink that reads on them",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "dice",
        "dice-notation",
        "rpg",
        "ttrpg",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "doctrine/orm": "^3.7",
        "phil/resource": "^0.1@dev",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "tilttek/dice": "^0.1@dev"
    },
    "require-dev": {
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3",
        "phpunit/phpunit": "^13.4",
        "symfony/clock": "^8.2",
        "symfony/event-dispatcher": "^8.2",
        "symfony/form": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/options-resolver": "^8.2",
        "symfony/translation": "^8.2",
        "symfony/translation-contracts": "^3.6",
        "symfony/twig-bundle": "^8.2",
        "symfony/validator": "^8.2",
        "twig/twig": "^3.21"
    },
    "suggest": {
        "symfony/form": "For the DiceExpressionType field",
        "symfony/translation": "To translate the words of a roll and the labels of the faces",
        "symfony/twig-bundle": "For the filters, the functions and the detail of a roll in templates",
        "symfony/validator": "For the DiceExpression constraint"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\DiceBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\DiceBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    }
}
