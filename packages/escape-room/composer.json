{
    "name": "tilttek/escape-room",
    "description": "Run escape rooms built from chained puzzles: a countdown, hints that cost time, a host console, bookable sessions and a leaderboard by consent.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "phil/resource": "^0.1@dev",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "symfony/clock": "^8.2",
        "tilttek/puzzle-builder": "^0.1@dev"
    },
    "require-dev": {
        "phil/reservation": "^0.1@dev",
        "phpunit/phpunit": "^13.4"
    },
    "suggest": {
        "phil/reservation": "For BookableSessionReservations: the sessions of the rooms booked as intervals of a bookable resource, with its opening hours, notice and booking window"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\EscapeRoom\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\EscapeRoom\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
