{
    "name": "tilttek/game-engine",
    "description": "A generic state machine for online table games and role-playing scenes, without game rules: phases on Symfony Workflow, sequential, initiative, simultaneous or free turns, each table a log of moves with its seed and its state rebuilt by replay, deterministic chance, undo, optimistic concurrency and a publishing port",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "game-engine",
        "state-machine",
        "turn-based",
        "initiative",
        "event-sourcing",
        "replay",
        "ttrpg",
        "workflow"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "symfony/options-resolver": "^8.2",
        "symfony/workflow": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\GameEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\GameEngine\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
