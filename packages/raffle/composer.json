{
    "name": "tilttek/raffle",
    "description": "Raffles where everyone holds one chance and nobody buys more: the entrant list is fixed and hashed first, and anyone can check the draw was fair.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-sodium": "*",
        "phil/url": "^0.1.3@dev",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "symfony/http-client-contracts": "^3.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "symfony/http-client": "^8.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\Raffle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\Raffle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
