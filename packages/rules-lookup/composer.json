{
    "name": "tilttek/rules-lookup",
    "description": "Search the rules of a game system, SRD included, in the reader's language: every result shows the source and licence it comes from.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "rpg",
        "ttrpg",
        "rules",
        "srd",
        "search",
        "attribution"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "symfony/polyfill-intl-normalizer": "^1.43",
        "tilttek/rpg-systems": "^0.1@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "suggest": {
        "ext-intl": "Normalises the text faster than the polyfill does."
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\RulesLookup\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\RulesLookup\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
