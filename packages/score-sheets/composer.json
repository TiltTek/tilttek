{
    "name": "tilttek/score-sheets",
    "description": "Keep score from a sheet declared per game as data: totals, ranks and tie-breakers computed and explained at each entry, team scores, and a blank sheet to print.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "score-sheet",
        "scoring",
        "board-games",
        "tie-breakers",
        "leaderboard"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\ScoreSheets\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\ScoreSheets\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
