{
    "name": "tilttek/fantasy-calendar",
    "description": "Keep time in an imaginary world: its own months, weeks, leap years, moons, eras and seasons, linked calendars, ages, reminders and a date that moves on.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "calendar",
        "fantasy-calendar",
        "worldbuilding",
        "moon-phases",
        "rpg",
        "ttrpg"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\FantasyCalendar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\FantasyCalendar\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
