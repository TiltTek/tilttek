{
    "name": "tilttek/encounter",
    "description": "Prepare game encounters balanced by the difficulty rules each game system declares, then hand the combatants to any initiative tracker.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "role-playing-games",
        "encounter",
        "encounter-builder",
        "difficulty",
        "initiative"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "tilttek/rpg-systems": "^0.1@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\Encounter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\Encounter\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
