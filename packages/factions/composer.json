{
    "name": "tilttek/factions",
    "description": "Track where the party and each character stand with the factions of a campaign: named tiers, ranks, relations between factions, every change with its reason.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "role-playing-games",
        "factions",
        "reputation",
        "campaign",
        "game-master"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "symfony/clock": "^8.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\Factions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\Factions\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
