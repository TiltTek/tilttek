{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:tilttek:generator:map:1",
    "title": "Map made by tilttek/generator",
    "description": "A square grid, a hex grid in rows where every odd row is pushed half a cell to the right, or a graph of nodes joined by passages, every node reachable.",
    "oneOf": [
        {
            "$ref": "#/$defs/square"
        },
        {
            "$ref": "#/$defs/hex"
        },
        {
            "$ref": "#/$defs/graph"
        }
    ],
    "$defs": {
        "value": {
            "description": "What the cell or the node holds: a text, or the fields of a structured result.",
            "type": [
                "string",
                "number",
                "boolean",
                "null",
                "object",
                "array"
            ]
        },
        "square": {
            "type": "object",
            "required": [
                "$schema",
                "version",
                "layout",
                "width",
                "height",
                "cells"
            ],
            "additionalProperties": false,
            "properties": {
                "$schema": {
                    "const": "urn:tilttek:generator:map:1"
                },
                "version": {
                    "const": 1
                },
                "layout": {
                    "const": "square"
                },
                "width": {
                    "type": "integer",
                    "minimum": 1
                },
                "height": {
                    "type": "integer",
                    "minimum": 1
                },
                "cells": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "x",
                            "y",
                            "value"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "x": {
                                "type": "integer",
                                "minimum": 0
                            },
                            "y": {
                                "type": "integer",
                                "minimum": 0
                            },
                            "value": {
                                "$ref": "#/$defs/value"
                            }
                        }
                    }
                }
            }
        },
        "hex": {
            "type": "object",
            "required": [
                "$schema",
                "version",
                "layout",
                "width",
                "height",
                "cells"
            ],
            "additionalProperties": false,
            "properties": {
                "$schema": {
                    "const": "urn:tilttek:generator:map:1"
                },
                "version": {
                    "const": 1
                },
                "layout": {
                    "const": "hex"
                },
                "width": {
                    "type": "integer",
                    "minimum": 1
                },
                "height": {
                    "type": "integer",
                    "minimum": 1
                },
                "cells": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "col",
                            "row",
                            "q",
                            "r",
                            "value"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "col": {
                                "type": "integer",
                                "minimum": 0
                            },
                            "row": {
                                "type": "integer",
                                "minimum": 0
                            },
                            "q": {
                                "type": "integer"
                            },
                            "r": {
                                "type": "integer",
                                "minimum": 0
                            },
                            "value": {
                                "$ref": "#/$defs/value"
                            }
                        }
                    }
                }
            }
        },
        "graph": {
            "type": "object",
            "required": [
                "$schema",
                "version",
                "layout",
                "nodes",
                "edges"
            ],
            "additionalProperties": false,
            "properties": {
                "$schema": {
                    "const": "urn:tilttek:generator:map:1"
                },
                "version": {
                    "const": 1
                },
                "layout": {
                    "const": "graph"
                },
                "nodes": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "required": [
                            "id",
                            "value"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "id": {
                                "type": "integer",
                                "minimum": 0
                            },
                            "value": {
                                "$ref": "#/$defs/value"
                            }
                        }
                    }
                },
                "edges": {
                    "type": "array",
                    "items": {
                        "description": "A passage between two nodes, the smaller identifier first.",
                        "type": "array",
                        "prefixItems": [
                            {
                                "type": "integer",
                                "minimum": 0
                            },
                            {
                                "type": "integer",
                                "minimum": 0
                            }
                        ],
                        "minItems": 2,
                        "maxItems": 2
                    }
                }
            }
        }
    }
}
