{
    "name": "tilttek/generator",
    "description": "Random generators written as data, without code: weighted lists and Twig templates that draw names, characters, treasures or maps, reproducible on demand.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "generator",
        "random-tables",
        "name-generator",
        "procedural-generation",
        "rpg",
        "tracery",
        "ttrpg",
        "twig"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "symfony/yaml": "^8.2",
        "tilttek/dice": "^0.3@dev",
        "twig/twig": "^3.31.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\Generator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\Generator\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    }
}
