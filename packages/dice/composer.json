{
    "name": "tilttek/dice",
    "description": "Dice notation parsed, validated, normalised and rolled: pools, Fudge and custom dice, keep and drop, explosions, rerolls and successes, localised notations, verifiable rolls by seed commitment, replayable rolls, a reader of Rolisteam's DiceParser notation, macros named by token, and the dialects of virtual tabletops",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "dice",
        "dice-notation",
        "rpg",
        "ttrpg",
        "provably-fair",
        "roll20",
        "foundry-vtt"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-mbstring": "*",
        "ext-sodium": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\Dice\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\Dice\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
