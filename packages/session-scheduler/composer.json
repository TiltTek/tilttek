{
    "name": "tilttek/session-scheduler",
    "description": "Keep a campaign's sessions on track: recurring dates planned in batches, absences with notice, postponing, substitute game masters and reminders.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "role-playing-games",
        "campaign",
        "scheduling",
        "recurrence",
        "game-master"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "phil/recurrence": "^0.1@dev",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "symfony/clock": "^8.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\SessionScheduler\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\SessionScheduler\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
