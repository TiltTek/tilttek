{
    "name": "tilttek/card-deck",
    "description": "Card decks for online play: shuffled from a verifiable seed, drawn, dealt and discarded, with each player sent only the cards they may see.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "cards",
        "card-game",
        "deck",
        "shuffle",
        "provably-fair",
        "board-games"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "tilttek/dice": "^0.3@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\CardDeck\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\CardDeck\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
