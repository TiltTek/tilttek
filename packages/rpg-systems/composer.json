{
    "name": "tilttek/rpg-systems",
    "description": "Describe a role-playing game system once so every tool reads it: attributes, rolls, terms, translations, and the source and licence of every record.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "rpg",
        "ttrpg",
        "game-systems",
        "srd",
        "orc-license",
        "creative-commons",
        "attribution"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "composer-runtime-api": "^2.2",
        "phil/url": "^0.1.4@dev",
        "symfony/yaml": "^8.2",
        "tilttek/dice": "^0.3@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\RpgSystems\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\RpgSystems\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
