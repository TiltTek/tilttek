{
    "name": "tilttek/rating",
    "description": "Rate players' skill per game from their results, with Elo or OpenSkill, for duels, multiplayer games and teams, private by default and public with consent.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "rating",
        "elo",
        "openskill",
        "ranking",
        "game"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "psr/event-dispatcher": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "suggest": {
        "tilttek/play-log": "To replay the ratings of a game from its log of plays, through a source of results"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\Rating\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\Rating\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
