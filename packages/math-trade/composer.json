{
    "name": "tilttek/math-trade",
    "description": "Math trades for games: from everyone's offers and ranked wishes, find the most trades as loops, each gives one and receives one, reproducible from a seed.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "math-trade",
        "board-games",
        "trading",
        "assignment",
        "cycles"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\MathTrade\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\MathTrade\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
