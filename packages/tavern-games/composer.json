{
    "name": "tilttek/tavern-games",
    "description": "Classic dice and card games for a tavern table online, turn by turn: fair dice and shuffles, each player sent only their own cards.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "tavern-games",
        "dice",
        "cards",
        "turn-based",
        "game-engine"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-sodium": "*",
        "tilttek/card-deck": "^0.1@dev",
        "tilttek/dice": "^0.3@dev",
        "tilttek/game-engine": "^0.1@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\TavernGames\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\TavernGames\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
