{
    "name": "tilttek/session-prep",
    "description": "Prepare a game session: scenes, secrets and their clues, NPCs, places, notes and a checklist, with what the table reveals recorded and leftovers carried over.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "role-playing-games",
        "game-master",
        "session-preparation",
        "campaign"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\SessionPrep\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\SessionPrep\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
