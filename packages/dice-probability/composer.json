{
    "name": "tilttek/dice-probability",
    "description": "Exact probabilities of tilttek/dice expressions: distributions as exact fractions, at least and at most, mean and standard deviation, events on the faces of a set of dice, two expressions compared, explosions followed to a depth, and seeded estimates past a size",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "dice",
        "probability",
        "statistics",
        "rpg",
        "ttrpg"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "tilttek/dice": "^0.1@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\DiceProbability\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\DiceProbability\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
