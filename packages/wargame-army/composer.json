{
    "name": "tilttek/wargame-army",
    "description": "Build and check army lists for miniatures games: units, options, points and constraints validated rule by rule, from catalogues you provide, none bundled.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\WargameArmy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\WargameArmy\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
