{
    "name": "tilttek/table-rules",
    "description": "Keep a table's house rules versioned, accepted by each player and re-accepted when they change, with what changed between versions; system-neutral.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "role-playing-games",
        "house-rules",
        "table-rules",
        "consent",
        "versioning"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "psr/clock": "^1.0",
        "tilttek/rpg-systems": "^0.1@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "symfony/clock": "^8.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\TableRules\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\TableRules\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
