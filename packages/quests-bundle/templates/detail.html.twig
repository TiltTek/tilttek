{#
 # One quest as a member sees it: its state, each step with what counted towards it, the team that follows it and the
 # rewards it declares. The texts are translation keys — `quests.<code>.name`, `quests.<code>.description`,
 # `quests.<code>.steps.<step>` and `rewards.<kind>` —:
 #
 #     {{ include('@TilttekQuests/detail.html.twig', {status: tilttek_quests_status('member:44', 'winter-reading')}) }}
 #}
{% set domain = tilttek_quests_domain() %}
{% set quest = status.quest %}
<article class="tilttek-quests-detail tilttek-quests-detail--{{ status.state.value }}" data-quest="{{ quest.code }}">
    <h3 class="tilttek-quests-detail__name">{{ ('quests.' ~ quest.code ~ '.name')|trans({}, domain) }}</h3>
    <p class="tilttek-quests-detail__description">{{ ('quests.' ~ quest.code ~ '.description')|trans({}, domain) }}</p>
    <p class="tilttek-quests-detail__state">{{ ('state.' ~ status.state.value)|trans({}, domain) }}</p>
    {% if status.team %}<p class="tilttek-quests-detail__team">{{ 'team'|trans({'%team%': status.team.id}, domain) }}</p>{% endif %}
    <{{ quest.ordered ? 'ol' : 'ul' }} class="tilttek-quests-detail__steps">
        {% for step in status.progress.steps %}
            <li class="tilttek-quests-detail__step{{ step.done ? ' tilttek-quests-detail__step--done' : '' }}">
                <span>{{ ('quests.' ~ quest.code ~ '.steps.' ~ step.step.code)|trans({}, domain) }}</span>
                <progress max="{{ step.step.target }}" value="{{ step.current }}">{{ step.percent }} %</progress>
                <span class="tilttek-quests-detail__count">{{ step.current }} / {{ step.step.target }}</span>
            </li>
        {% endfor %}
    </{{ quest.ordered ? 'ol' : 'ul' }}>
    {% if quest.rewards is not empty %}
        <ul class="tilttek-quests-detail__rewards">
            {% for reward in quest.rewards %}
                <li>{{ ('rewards.' ~ reward.kind)|trans({'%code%': reward.code, '%amount%': reward.amount}, domain) }}</li>
            {% endfor %}
        </ul>
    {% endif %}
    {% if status.completion %}
        <time class="tilttek-quests-detail__completed" datetime="{{ status.completion.completedAt|date('c') }}">{{ 'completed'|trans({'%date%': status.completion.completedAt|date('Y-m-d')}, domain) }}</time>
    {% endif %}
</article>
