{
    "name": "tilttek/geek-dates",
    "description": "Show geek culture days on the right date every year: rules such as \"last friday of july\", each with its source, community and the day it was checked.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "calendar",
        "geek",
        "fandom",
        "dates",
        "almanac",
        "events"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "phil/almanac": "^0.1@dev",
        "phil/url": "^0.1.4@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\GeekDates\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\GeekDates\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
