{
    "name": "tilttek/mini-games",
    "description": "Small games played alone, with a daily game everyone shares, results shared without spoilers and no streak that punishes a missed day.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "mini-games",
        "daily-game",
        "puzzle",
        "game-engine",
        "accessibility"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "tilttek/game-engine": "^0.1@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\MiniGames\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\MiniGames\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
