{
    "name": "tilttek/downtime",
    "description": "Track what characters do between sessions: activities the game system declares, with their days, costs and outcomes, in a log per character.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "role-playing-games",
        "downtime",
        "campaign",
        "game-master",
        "character-log"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\Downtime\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\Downtime\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
