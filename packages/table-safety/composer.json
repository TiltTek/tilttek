{
    "name": "tilttek/table-safety",
    "description": "Table safety tools for tabletop and live-action role-playing games: lines and veils, a consent checklist with a table's anonymous agreement, session zero and its pact, the X-card, Script Change and the open door as anonymous signals, check-ins, stars and wishes, and a participant's export and erasure",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "table-safety",
        "x-card",
        "lines-and-veils",
        "consent",
        "session-zero",
        "tabletop",
        "rpg",
        "larp"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "ext-sodium": "*",
        "phil/content-warnings": "^0.1@dev",
        "phil/resource": "^0.1@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\TableSafety\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\TableSafety\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
