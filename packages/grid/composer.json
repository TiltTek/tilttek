{
    "name": "tilttek/grid",
    "description": "Measure, snap and align game maps exactly: square, hex and isometric grids with coordinates, distances, lines of sight and areas of effect, without floats.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "grid",
        "hex-grid",
        "hexagon",
        "map",
        "isometric",
        "line-of-sight",
        "rpg",
        "ttrpg"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\Grid\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\Grid\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
