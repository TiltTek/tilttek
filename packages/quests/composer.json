{
    "name": "tilttek/quests",
    "description": "Quests and challenges built from what members do: steps, dates, chains and rewards, for one member, a team, the whole community, or two members racing.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "quests",
        "challenges",
        "missions",
        "duels",
        "gamification"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "phil/resource": "^0.1@dev",
        "psr/clock": "^1.0",
        "tilttek/activity": "^0.1@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\Quests\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\Quests\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.3.x-dev"
        }
    }
}
