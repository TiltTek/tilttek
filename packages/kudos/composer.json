{
    "name": "tilttek/kudos",
    "description": "Members thank each other with fixed, translated messages, capped per day and per member, and never ranked: no public count, generous givers earn badges.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "gamification",
        "kudos",
        "thanks",
        "recognition",
        "community",
        "activity"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "phil/resource": "^0.1@dev",
        "psr/clock": "^1.0",
        "tilttek/activity": "^0.1@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "symfony/clock": "^8.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\Kudos\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\Kudos\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
