{
    "name": "tilttek/handouts",
    "description": "Reveal handouts to all players or some, now, at a set moment or on a cue during play, and track which revision each player has seen.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "rpg",
        "ttrpg",
        "handouts",
        "game-master",
        "reveal"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "phil/resource": "^0.1@dev",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "symfony/clock": "^8.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\Handouts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\Handouts\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
