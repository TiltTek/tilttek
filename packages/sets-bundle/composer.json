{
    "name": "tilttek/sets-bundle",
    "description": "Use tilttek/sets in Symfony: stores chosen by configuration, and completions whose event was lost sent again by a command or a schedule.",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "sets",
        "badges",
        "collections",
        "gamification",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "phil/resource": "^0.1@dev",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "tilttek/sets": "^0.3@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "psr/clock": "^1.0",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "symfony/console": "^8.2",
        "symfony/event-dispatcher": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/lock": "^8.2",
        "symfony/messenger": "^8.2",
        "symfony/scheduler": "^8.2",
        "symfony/yaml": "^8.2"
    },
    "suggest": {
        "symfony/console": "For the tilttek:sets:deliver command, which tells again the completions whose event was not delivered",
        "symfony/lock": "To keep two workers consuming the delivery schedule from both sending its message",
        "symfony/messenger": "For the handler of the message that tells again the completions whose event was not delivered",
        "symfony/scheduler": "For the schedule that sends that message at an interval"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\SetsBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\SetsBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
