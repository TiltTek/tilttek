{
    "name": "tilttek/exchange",
    "description": "Let members buy rewards with points, give points to each other and trade items, safely and only once, with guards against abuse.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "exchange",
        "rewards",
        "redemption",
        "trading",
        "gamification",
        "loyalty"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "phil/resource": "^0.1@dev",
        "psr/clock": "^1.0",
        "tilttek/points": "^0.2@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\Exchange\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\Exchange\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    }
}
