{
    "name": "tilttek/rpg-calendar-events",
    "description": "Show roleplaying community events on the right date every year, and the day index of a month of daily prompts: rules with their source, ready for quests.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "rpg",
        "ttrpg",
        "calendar",
        "events",
        "prompts",
        "almanac"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "phil/almanac": "^0.1@dev",
        "phil/url": "^0.1.4@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\RpgCalendarEvents\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\RpgCalendarEvents\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
