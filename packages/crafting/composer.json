{
    "name": "tilttek/crafting",
    "description": "Item recipes kept as data: combine or evolve items, by code or by tag, see what is missing before crafting, and craft once per request, all or nothing.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "gamification",
        "crafting",
        "recipes",
        "inventory",
        "items"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "phil/resource": "^0.1@dev",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "symfony/clock": "^8.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\Crafting\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\Crafting\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
