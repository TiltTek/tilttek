{
    "name": "tilttek/random-character",
    "description": "Roll a ready-to-play character by the creation rules a game system declares: attributes in their bounds, names and traits from tables, replayable from a seed.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "role-playing-games",
        "character-generator",
        "random-character",
        "random-tables",
        "dice",
        "ttrpg"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "symfony/yaml": "^8.2",
        "tilttek/dice": "^0.3@dev",
        "tilttek/generator": "^0.2@dev",
        "tilttek/rpg-systems": "^0.1@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\RandomCharacter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\RandomCharacter\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
