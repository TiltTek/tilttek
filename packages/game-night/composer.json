{
    "name": "tilttek/game-night",
    "description": "Run the game nights of a club or store: tables and seats, sign-ups with a guest and a waiting list, games picked for the players and the time, a vote.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "board-games",
        "game-night",
        "sign-up",
        "waiting-list",
        "vote",
        "club",
        "game-store"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "psr/clock": "^1.0",
        "tilttek/game-catalog": "^0.1@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "symfony/clock": "^8.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\GameNight\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\GameNight\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
