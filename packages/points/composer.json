{
    "name": "tilttek/points",
    "description": "A double-entry ledger of points for gamification: balances that are sums of movements, named currencies, earning rules on members' activity with caps per period, first-in first-out expiry, cancellations as reverse movements, spending and transfers that never go negative, rebuilds, and the erasure of a member",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "points",
        "ledger",
        "double-entry",
        "gamification",
        "loyalty",
        "rewards"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "phil/resource": "^0.1@dev",
        "psr/clock": "^1.0",
        "tilttek/activity": "^0.1@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\Points\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\Points\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
