{
    "name": "tilttek/quiz",
    "description": "Quiz games: questions of six kinds, a timer on an injected clock, scoring with a speed bonus, self-paced plays for members and live sessions with pseudonymous guests and teams, standings, a pseudonym filter, live updates through Mercure, and the events and Stimulus hook of a celebration.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "quiz",
        "trivia",
        "game",
        "live-quiz",
        "symfony-ux"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "symfony/mercure": "^0.10",
        "twig/twig": "^3.21"
    },
    "suggest": {
        "symfony/mercure": "To push the moves of a live session to the screens of its host and players, as private updates naming identifiers only"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tilttek\\Quiz\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tilttek\\Quiz\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
