{#
 # Results of a generator, drawn again in place by the Stimulus controller:
 #
 #     {{ include('@TilttekGenerator/draw.html.twig', {
 #         result: tilttek_draw('name.elf', 5, true),
 #         url: path('tilttek_generator_draw', {generator: 'name.elf'}),
 #         again: 'Again',
 #     }) }}
 #
 # A structured result shows its `name` field, or its JSON; the application writes its own template to show more.
 # The attributions of the lists and generators the results used follow them: each its attribution, or its source,
 # then its licence.
 #}
{% set controller = 'tilttek--generator-bundle--generator' %}
<div class="tilttek-generator" data-controller="{{ controller }}"
     data-{{ controller }}-url-value="{{ url }}"
     data-{{ controller }}-count-value="{{ result.requested }}">
    <ul data-{{ controller }}-target="results">
        {% for value in result.results %}
            <li>{{ value is iterable ? (value.name ?? value|json_encode) : value }}</li>
        {% endfor %}
    </ul>
    <p class="tilttek-generator-attribution" data-{{ controller }}-target="attribution">
        {%- for credit in result.attributions -%}
            {%- set text = credit.attribution ?? credit.source -%}
            {{- text is null ? credit.licence : (credit.licence is null ? text : text ~ ' (' ~ credit.licence ~ ')') -}}
            {{- loop.last ? '' : '; ' -}}
        {%- endfor -%}
    </p>
    <p data-{{ controller }}-target="status" role="status">{{ result.short ? short|default('Fewer results than asked were found.') }}</p>
    <button type="button" data-action="{{ controller }}#draw">{{ again|default('Again') }}</button>
</div>
